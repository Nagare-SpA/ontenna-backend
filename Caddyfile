# Railway terminates TLS at its edge and forwards plain HTTP to $PORT, so no
# HTTPS here. Cloudflare sits in front for the global CDN/cache.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# SPA fallback: unknown paths (e.g. /dashboard, /reset-password) serve the
	# app shell instead of 404 — replaces the Vercel rewrite rule.
	try_files {path} /index.html
	file_server

	# Hashed build assets are immutable; everything else (the HTML shell above
	# all) must never be cached. The two matchers are disjoint on purpose: a
	# bare catch-all `header Cache-Control` would also overwrite the assets'
	# value, since every matching header directive runs and the last one wins.
	@assets path /assets/*
	@shell not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @shell Cache-Control "no-cache"

	# Vercel sent HSTS on its own; Caddy does not, since TLS terminates at
	# Railway's edge. Browsers already hold a 2-year pin for ontenna.org, so
	# dropping the header would be a silent downgrade. Value copied from the
	# Vercel response verbatim — no includeSubDomains, which would newly force
	# HTTPS on every subdomain.
	header Strict-Transport-Security "max-age=63072000"
}
